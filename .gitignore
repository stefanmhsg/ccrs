# Ignore Gradle project-specific cache directory
.gradle

# Ignore local GitHub/Copilot material, but keep Actions workflows versioned
.github/*
!.github/workflows/
!.github/workflows/**

# Ignore Gradle build output directory
build

# Compiled class file
*.class

# Log file
*.log*

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz

# Standalone ccrs-langgraph build and runtime-resolver state.
ccrs-langgraph/build/
ccrs-langgraph/dist/
ccrs-langgraph/*.egg-info/
ccrs-langgraph/src/*.egg-info/
ccrs-langgraph/**/__pycache__/
ccrs-langgraph/.venv*/
ccrs-langgraph/src/ccrs_langgraph/_runtime_resolver/.gradle/
ccrs-langgraph/src/ccrs_langgraph/_runtime_resolver/build/
ccrs-langgraph/src/ccrs_langgraph/_runtime_resolver/.tmp-ccrs-runtime-*/
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
.vscode/settings.json
.vscode/tasks.json

log/mas-0.log.lck
*.lck
bin/

# Environment variables (contains API keys)
.env
